# =============================================================
# Single .env for the entire project (root of repo)
# Python agent and Next.js dashboard both load from here.
# Copy this to .env and fill in your values.
# =============================================================

# LiveKit — https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Deepgram (STT & TTS) — https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key

# Groq (LLM) — https://console.groq.com/
GROQ_API_KEY=your_groq_key
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Vobiz / SIP Trunking
VOBIZ_SIP_TRUNK_ID=your_trunk_id
OUTBOUND_TRUNK_ID=your_trunk_id
VOBIZ_SIP_DOMAIN=your_sip_domain
VOBIZ_USERNAME=your_sip_username
VOBIZ_PASSWORD=your_sip_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — TTS provider (sarvam | deepgram | cartesia | openai)
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_key
GREETING_POST_CONNECT_DELAY_SEC=0.45
SARVAM_MIN_BUFFER_SIZE=100

# Optional — OpenAI (only needed if model_provider=openai in the dashboard)
OPENAI_API_KEY=your_openai_key

# Optional — Pinecone (for vector-based knowledge base)
# https://app.pinecone.io — free tier: 1 index, 100k vectors
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=knowledge-base

# Lead-source integrations
# AES-256-GCM key for encrypting stored OAuth tokens (generate: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=your_32_byte_hex_key
# Bearer token for internal cron endpoints (generate: openssl rand -hex 24)
CRON_BEARER=your_cron_bearer_token
# Public URL of the dashboard (used in webhook URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Google Sheets integration — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# HubSpot integration — https://developers.hubspot.com/docs/api/overview
# Create a Public App at: https://developers.hubspot.com/
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret

# Optional — Supabase Storage S3 gateway (for call recordings)
# Get these from Supabase dashboard → Storage → Settings → S3 Connection
# Create a PUBLIC bucket named "call-recordings" first
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-region
SUPABASE_S3_ACCESS_KEY=your_s3_access_key
SUPABASE_S3_SECRET_KEY=your_s3_secret_key
SUPABASE_STORAGE_BUCKET=call-recordings
